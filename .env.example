# Set these as environment variables; Tomcat does not read .env automatically.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ltweb_postgre
DB_USER=ltweb_app
DB_PASSWORD=replace_with_your_password
DB_SSLMODE=disable
DB_TABLE=w2_survey
# On Render: internal host, port 5432, database credentials, DB_SSLMODE=require.
